{
    "version": "0.2.0",
    "configurations": [
        {
            // Starts the provider with -debug. Copy the printed
            // TF_REATTACH_PROVIDERS value into the shell running terraform.
            "name": "Debug Terraform Provider",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}",
            "args": ["-debug"]
        }
    ]
}
